# --- Python: bytecode e cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribuição / build ---
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- uv ---
# uv.lock pode ser commitado ou não. Vamos commitar pra reprodutibilidade.
# Se preferir ignorar, descomente:
# uv.lock

# --- Testes e coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.cache/

# --- Lint e type checking ---
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# --- Variáveis de ambiente e segredos ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Logs ---
*.log
logs/

# --- Dados locais de execução ---
data/
output/
tmp/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini